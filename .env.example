# Eiendomly CRM – example environment variables.
# Copy to .env.local for local development (git-ignored), and set the real
# values in Netlify: Site configuration → Environment variables.
# NEVER put real keys in this file or anywhere in GitHub.
# None of these use NEXT_PUBLIC_, so they never reach the browser.

# Supabase (Project settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Bypasses Row Level Security. Server only: n8n webhook + unsubscribe link.
SUPABASE_SERVICE_ROLE_KEY=

# Claude (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# Optional overrides
# CRM_AI_MODEL=claude-opus-5-5
# CRM_AI_EFFORT=low

# Outgoing e-mail (Webhuset: smtp.webhuset.no, port 465, SSL)
SMTP_HOST=smtp.webhuset.no
SMTP_PORT=465
SMTP_USER=kontakt@eiendomly.no
SMTP_PASSWORD=
OUTREACH_FROM="Eiendomly <kontakt@eiendomly.no>"
OUTREACH_REPLY_TO=kontakt@eiendomly.no

# Incoming e-mail for replies, «nei takk» and bounces (read-only).
# Defaults to the SMTP user/password if left empty.
IMAP_HOST=imap.webhuset.no
IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=

# Sending stays OFF until the system is tested and approved.
OUTREACH_SENDING_ENABLED=false

# Random secrets: generate with `openssl rand -hex 32`
UNSUBSCRIBE_SECRET=
# Lets the scheduler and the admin panel start the background worker.
CRM_WORKER_SECRET=
N8N_WEBHOOK_SECRET=
# Optional: n8n webhook that receives CRM events
# N8N_EVENTS_WEBHOOK_URL=

CRM_SITE_URL=https://eiendomly.no
